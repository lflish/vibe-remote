{
  "name": "vibe-remote",
  "version": "0.1.3",
  "private": true,
  "description": "Remote Claude terminal manager",
  "license": "MIT",
  "author": "lflish",
  "repository": {
    "type": "git",
    "url": "https://github.com/lflish/vibe-remote.git"
  },
  "bugs": "https://github.com/lflish/vibe-remote/issues",
  "homepage": "https://github.com/lflish/vibe-remote#readme",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "start": "electron dist/main/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:preserved-notice && npm run test:attach-replay && npm run test:terminal-layout && npm run test:terminal-clipboard && npm run test:terminal-selection && npm run test:client-reconnect && npm run test:machine-store && npm run test:i18n-parity",
    "test:preserved-notice": "node -e \"const fs=require('fs');const s=fs.readFileSync('src/renderer/index.ts','utf8');const f=s.slice(s.indexOf('async function closeSession'),s.indexOf('function renderEmptyState'));const preserved=f.indexOf(\\\"e.code === 'worktree_preserved'\\\");const refresh=f.indexOf('await refreshAllMachines()',preserved);const notice=f.indexOf(\\\"t('session.worktreePreserved'\\\",preserved);if(!(preserved>=0&&refresh>preserved&&notice>refresh))throw new Error('Worktree-preserved notice must be applied after awaited refresh');\"",
    "test:attach-replay": "node scripts/test-attach-replay.mjs",
    "test:terminal-layout": "node scripts/test-terminal-layout.mjs",
    "test:terminal-clipboard": "node scripts/test-terminal-clipboard.mjs",
    "test:terminal-selection": "node scripts/test-terminal-selection.mjs",
    "test:client-reconnect": "node scripts/test-client-reconnect.mjs",
    "test:machine-store": "node scripts/test-machine-store.mjs",
    "test:i18n-parity": "node scripts/test-i18n-parity.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.12.0-beta.299",
    "@xterm/xterm": "6.1.0-beta.302"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vite-plugin-electron": "0.28.8"
  },
  "build": {
    "appId": "com.vibe-remote.app",
    "productName": "vibe-remote",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "directories": {
      "output": "release"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "dist/shared/**/*"
    ]
  }
}
