{
  "name": "vibe-remote",
  "version": "0.1.0",
  "description": "Remote Claude terminal manager",
  "license": "MIT",
  "author": "lflish",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "start": "electron dist/main/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vibe-remote/core": "^0.1.0",
    "@vibe-remote/ui": "^0.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.0"
  },
  "build": {
    "appId": "com.vibe-remote.app",
    "productName": "vibe-remote",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "files": [
      "dist/**/*"
    ]
  }
}
