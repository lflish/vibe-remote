{
  "name": "vibe-remote",
  "version": "0.1.3",
  "private": true,
  "description": "Remote Claude terminal manager",
  "license": "MIT",
  "author": "lflish",
  "repository": {
    "type": "git",
    "url": "https://github.com/lflish/vibe-remote.git"
  },
  "bugs": "https://github.com/lflish/vibe-remote/issues",
  "homepage": "https://github.com/lflish/vibe-remote#readme",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "start": "electron dist/main/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:preserved-notice && npm run test:attach-replay && npm run test:terminal-layout && npm run test:picker-layout && npm run test:slash-menu-layout && npm run test:terminal-clipboard && npm run test:terminal-selection && npm run test:client-reconnect && npm run test:client-liveness && npm run test:machine-store && npm run test:i18n-parity && npm run test:chat-client && npm run test:chat-parser && npm run test:chat-session && npm run test:chat-permission && npm run test:chat-diff && npm run test:chat-queue && npm run test:chat-markdown && npm run test:chat-render-guard && npm run test:chat-window && npm run test:chat-view && npm run test:chat-availability && npm run test:chat-activity && npm run test:rest-projects && npm run test:tree && npm run test:sidebar && npm run test:worktree-name && npm run test:session-form && npm run test:worktree-dialogs && npm run test:dialog-layout && npm run test:shortcuts",
    "test:preserved-notice": "node -e \"const fs=require('fs');const s=fs.readFileSync('src/renderer/index.ts','utf8');const f=s.slice(s.indexOf('async function closeSession'),s.indexOf('function renderEmptyState'));const preserved=f.indexOf(\\\"e.code === 'worktree_preserved'\\\");const refresh=f.indexOf('await refreshAllMachines()',preserved);const notice=f.indexOf(\\\"t('session.worktreePreserved'\\\",preserved);if(!(preserved>=0&&refresh>preserved&&notice>refresh))throw new Error('Worktree-preserved notice must be applied after awaited refresh');\"",
    "test:attach-replay": "node scripts/test-attach-replay.mjs",
    "test:terminal-layout": "node scripts/test-terminal-layout.mjs",
    "test:picker-layout": "node scripts/test-picker-layout.mjs",
    "test:slash-menu-layout": "node scripts/test-slash-menu-layout.mjs",
    "test:terminal-clipboard": "node scripts/test-terminal-clipboard.mjs",
    "test:terminal-selection": "node scripts/test-terminal-selection.mjs",
    "test:client-reconnect": "node scripts/test-client-reconnect.mjs",
    "test:client-liveness": "node scripts/test-client-liveness.mjs",
    "test:machine-store": "node scripts/test-machine-store.mjs",
    "test:i18n-parity": "node scripts/test-i18n-parity.mjs",
    "test:chat-client": "node scripts/test-chat-client.mjs",
    "test:chat-parser": "node scripts/test-chat-parser.mjs",
    "test:chat-session": "node scripts/test-chat-session.mjs",
    "test:chat-permission": "node scripts/test-chat-permission.mjs",
    "test:chat-diff": "node scripts/test-chat-diff.mjs",
    "test:chat-queue": "node scripts/test-chat-queue.mjs",
    "test:chat-markdown": "node scripts/test-chat-markdown.mjs",
    "test:chat-render-guard": "node scripts/test-chat-render-guard.mjs",
    "test:chat-window": "node scripts/test-chat-window.mjs",
    "test:chat-view": "node scripts/test-chat-view.mjs",
    "test:chat-availability": "node scripts/test-chat-availability.mjs",
    "test:chat-activity": "node scripts/test-chat-activity.mjs",
    "test:rest-projects": "node scripts/test-rest-projects.mjs",
    "test:tree": "node scripts/test-tree.mjs",
    "test:sidebar": "node scripts/test-sidebar.mjs",
    "test:worktree-name": "node scripts/test-worktree-name.mjs",
    "test:session-form": "node scripts/test-session-form.mjs",
    "test:worktree-dialogs": "node scripts/test-worktree-dialogs.mjs",
    "test:dialog-layout": "node scripts/test-dialog-layout.mjs",
    "test:shortcuts": "node scripts/test-shortcuts.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.12.0-beta.299",
    "@xterm/xterm": "6.1.0-beta.302",
    "dompurify": "3.4.17",
    "markdown-it": "15.0.3"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vite-plugin-electron": "0.28.8"
  },
  "build": {
    "appId": "com.vibe-remote.app",
    "productName": "vibe-remote",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "directories": {
      "output": "release"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "dist/shared/**/*"
    ]
  }
}
